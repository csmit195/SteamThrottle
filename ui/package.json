{
  "name": "steamthrottle-ui",
  "private": true,
  "version": "0.1.1",
  "description": "A native Steam download throttler for League of Legends players.",
  "homepage": "https://github.com/csmit195/SteamThrottle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csmit195/SteamThrottle.git"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write src static",
    "format:check": "prettier --check src static",
    "test": "svelte-kit sync && vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.4.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.4",
    "@tauri-apps/cli": "^2"
  }
}

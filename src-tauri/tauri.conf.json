{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Throttle",
  "version": "0.1.0",
  "identifier": "io.github.csmit195.steamthrottle",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Steam Throttle",
        "width": 680,
        "height": 420,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4OEJCQTNEOTI1MUFENjQKUldSa3JWR1NQYnFMT08zajkzR25lWHBoUFNIaEVFQ0pWN0dwTzJnekJKSmNKOW5Ha1REbENBWDgK",
      "endpoints": [
        "https://github.com/csmit195/SteamThrottle/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "csmit195",
    "copyright": "Copyright © 2026 csmit195 and contributors",
    "shortDescription": "Steam download throttling for League players",
    "longDescription": "A native Steam download throttler for League of Legends players.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
